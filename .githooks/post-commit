#!/bin/sh
# 이 폴더에서 main 커밋을 만들면 GitHub에도 올립니다.
# 연결이 없거나 업로드에 실패해도 내 컴퓨터의 커밋은 그대로 남습니다.
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
[ "$branch" = "main" ] || exit 0
if ! git remote get-url origin >/dev/null 2>&1; then
  printf '%s\n' 'GitHub 저장소를 연결하면 커밋 후 자동 업로드가 시작됩니다.'
  exit 0
fi
if ! git push --set-upstream origin main; then
  printf '%s\n' '커밋은 저장됐지만 GitHub 업로드에 실패했습니다. 연결을 확인한 뒤 변경 내용 동기화를 눌러 주세요.' >&2
fi
exit 0
